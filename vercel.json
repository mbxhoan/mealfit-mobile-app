{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "vite --port $PORT",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/refresh.js": { "maxDuration": 60 },
    "api/media.js": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/refresh", "schedule": "0 3 * * *" }],
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/logout", "destination": "/api/auth?action=logout" },
    { "source": "/api/auth/session", "destination": "/api/auth?action=session" },
    { "source": "/api/orders/:code", "destination": "/api/orders?code=:code" },
    { "source": "/api/media/:id", "destination": "/api/media?id=:id" },
    { "source": "/api/health", "destination": "/api/ping?database=1" },
    { "source": "/api/cron/maintenance", "destination": "/api/refresh" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
